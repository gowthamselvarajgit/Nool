# ═══════════════════════════════════════════════════════════════════════════
# NOOL Backend — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in real values for local development.
# In production, set these as OS / hosting-platform env vars (do NOT commit
# the real .env to version control — it is in .gitignore).
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────
# Default: 8083. Most hosting platforms inject their own PORT.
SERVER_PORT=8083

# ── JWT ───────────────────────────────────────────────────────────────────
# REQUIRED in production. Must be at least 64 characters of random data.
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_me_with_a_long_random_string_at_least_64_characters_long_for_production
JWT_EXPIRATION=86400000

# ── Super Admin Seed ──────────────────────────────────────────────────────
# REQUIRED — used to seed the very first SUPER_ADMIN account on initial
# startup. After that, manage admins through the in-app super-admin UI.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_MOBILE=9876543210
SUPER_ADMIN_PASSWORD=ChangeMeNow@2026

# ── Database ──────────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/nool_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=root

# Set to `validate` in production after the first deploy.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ── Workshop Defaults ─────────────────────────────────────────────────────
# Fallback rate used only when an owner has no per-owner rate set.
NOOL_RATE_PER_SAREE=70.0

# ── CORS Allow-list ───────────────────────────────────────────────────────
# Comma-separated list of frontend origins permitted to call the API.
# Local dev default covers Vite (5173) + preview (4173). Add your deployed
# frontend URL(s) when going to production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Logging ───────────────────────────────────────────────────────────────
SQL_LOG_LEVEL=warn
SQL_BIND_LOG_LEVEL=warn
